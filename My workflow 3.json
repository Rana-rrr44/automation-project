    {
      "parameters": {
        "jsCode": "// جلب البيانات بشكل آمن\nconst webhookData = $('Webhook').first().json;\nconst order = webhookData.body || webhookData;\n\nconst inventory = $input.all();\n\n// اسم المنتج الجاي من الطلب\nconst requestedProduct = order.product ? order.product.toString().toLowerCase().trim() : '';\n\n// البحث عن المنتج في الشيت\nconst product = inventory.find(item => {\n  const sheetProduct = item.json.Product ? item.json.Product.toString().toLowerCase().trim() : '';\n  return sheetProduct === requestedProduct;\n});\n\n// لو المنتج مش موجود، بنرجع بيانات خفيفة عشان الـ If Node تعتبرها False من غير ما تشد Error\nif (!product) {\n  return [{\n    json: {\n      found: false,\n      message: \"Product not found in inventory\",\n      requestedQuantity: Number(order.quantity || 1)\n    }\n  }];\n}\n\n// لو لقاه، نحسب الكميات عادي\nconst currentStock = Number(product.json.Stock || 0);\nconst requestedQuantity = Number(order.quantity || 1);\nconst hasEnoughStock = currentStock >= requestedQuantity;\n\nreturn [{\n  json: {\n    found: true,\n    row_number: product.json.row_number,\n    Product: product.json.Product,\n    Stock: currentStock,\n    requestedQuantity: requestedQuantity,\n    newStock: currentStock - requestedQuantity,\n    hasEnoughStock: hasEnoughStock,\n    // بيانات العميل عشان الـ Orders Sheet\n    customerName: order.name || order.customerName,\n    phone: order.phone,\n    address: order.address\n  }\n}];"
      },
